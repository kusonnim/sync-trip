rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Accountless access cannot establish trusted per-user authority. These rules
    // limit paths and payloads; README.md documents the room-code trust boundary.
    function validCode(code) {
      return code.matches('^[A-HJ-NP-Z2-9]{4}$');
    }

    function roomExistsAfter(code) {
      return getAfter(/databases/$(database)/documents/rooms/$(code)).data.code == code;
    }

    function validRoom(data) {
      return data.keys().hasAll([
        'code', 'status', 'title', 'hostId', 'hostToken', 'startDate', 'endDate',
        'dailyStart', 'dailyEnd', 'headcount', 'transportMode', 'origin', 'destination'
      ])
      && data.keys().hasOnly([
        'code', 'status', 'title', 'hostId', 'hostToken', 'startDate', 'endDate',
        'dailyStart', 'dailyEnd', 'headcount', 'transportMode', 'origin', 'destination',
        'createdAt', 'updatedAt', 'confirmedRouteId', 'optimizationState',
        'optimizationOwner', 'optimizationRunId', 'optimizationStartedAt', 'optimizationFinishedAt'
      ])
      && data.code.matches('^[A-HJ-NP-Z2-9]{4}$')
      && data.status in ['setup', 'collecting', 'analyzing', 'voting', 'confirmed']
      && data.title is string && data.title.size() > 0 && data.title.size() <= 100
      && data.hostId is string && data.hostId.size() >= 16 && data.hostId.size() <= 80
      && data.hostToken is string && data.hostToken.size() >= 32 && data.hostToken.size() <= 128
      && data.headcount is int && data.headcount >= 2 && data.headcount <= 12
      && data.transportMode in ['car', 'transit'];
    }

    match /rooms/{roomCode} {
      allow read: if validCode(roomCode);
      allow create: if validCode(roomCode) && validRoom(request.resource.data);
      allow update: if validCode(roomCode)
        && validRoom(request.resource.data)
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.hostToken == resource.data.hostToken;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if validCode(roomCode);
        allow create, update: if validCode(roomCode) && roomExistsAfter(roomCode)
          && memberId.matches('^m-[a-f0-9]{24}$')
          && request.resource.data.keys().hasOnly(['nickname', 'joinedAt', 'submitted', 'isHost'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 40
          && request.resource.data.submitted is bool
          && request.resource.data.isHost is bool;
        allow delete: if false;
      }

      match /places/{placeId} {
        allow read: if validCode(roomCode);
        allow create, update: if validCode(roomCode) && roomExistsAfter(roomCode)
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'address', 'lat', 'lng', 'category', 'kakaoId', 'isFixed',
            'addedBy', 'openTime', 'closeTime', 'hoursSource', 'fixedTime', 'bestTime',
            'minStay', 'maxStay', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.lat is number
          && request.resource.data.lng is number;
        allow delete: if validCode(roomCode) && roomExistsAfter(roomCode);
      }

      match /preferences/{memberId} {
        allow read: if validCode(roomCode);
        allow create, update: if validCode(roomCode) && roomExistsAfter(roomCode)
          && request.resource.data.keys().hasOnly(['ranking', 'updatedAt'])
          && request.resource.data.ranking is list
          && request.resource.data.ranking.size() <= 10;
        allow delete: if validCode(roomCode) && roomExistsAfter(roomCode);
      }

      match /routes/{documentId} {
        allow read: if validCode(roomCode) && documentId == 'current';
        allow create, update: if validCode(roomCode) && roomExistsAfter(roomCode) && documentId == 'current'
          && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 2;
        allow delete: if validCode(roomCode) && roomExistsAfter(roomCode) && documentId == 'current';
      }

      match /errors/{documentId} {
        allow read: if validCode(roomCode) && documentId == 'current';
        allow create, update: if validCode(roomCode) && roomExistsAfter(roomCode) && documentId == 'current'
          && request.resource.data.keys().hasOnly(['code', 'message', 'placeIds', 'updatedAt'])
          && request.resource.data.code is string
          && request.resource.data.placeIds is list
          && request.resource.data.placeIds.size() <= 12
          && (!('message' in request.resource.data) || request.resource.data.message.size() <= 500);
        allow delete: if validCode(roomCode) && roomExistsAfter(roomCode) && documentId == 'current';
      }

      match /finalVotes/{memberId} {
        allow read: if validCode(roomCode);
        allow create, update: if validCode(roomCode) && roomExistsAfter(roomCode)
          && memberId.matches('^m-[a-f0-9]{24}$')
          && request.resource.data.keys().hasOnly(['routeId', 'updatedAt'])
          && request.resource.data.routeId in ['min_time', 'min_cost'];
        allow delete: if validCode(roomCode) && roomExistsAfter(roomCode);
      }
    }
  }
}
